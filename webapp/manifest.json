{
  "_version": "1.85.0",
  "sap.app": {
    "id": "view.navigation.tasks.ui5.ui5viewnavigationtask",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.25.0",
      "toolsId": "0484eb47-43d5-4e83-a0a8-07580fb33b5a"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.148.1",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "view.navigation.tasks.ui5.ui5viewnavigationtask.i18n.i18n"
        }
      },
      "userDetails": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "./model/userDetails.json"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "view.navigation.tasks.ui5.ui5viewnavigationtask.view",
        "async": true,
        "bypassed": {
          "target": "TargetNotFound"
        }
      },
      "routes": [
        {
          "pattern": "",
          "name": "RouteHome",
          "target": [
            "TargetHome"
          ]
        },
        {
          "pattern": "form/{selectedUserID1}/{selectedUserID2}:?query:",
          "name": "RouteForm",
          "target": [
            "TargetForm"
          ]
        }
      ],
      "targets": {
        "TargetHome": {
          "id": "Home",
          "name": "Home",
          "level": 1
        },
        "TargetForm": {
          "id": "Form",
          "name": "Form",
          "level": 2
        },
        "TargetNotFound": {
          "id": "notFound",
          "name": "NotFound",
          "transition": "show"
        }
      }
    },
    "rootView": {
      "viewName": "view.navigation.tasks.ui5.ui5viewnavigationtask.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
